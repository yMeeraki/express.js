<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <title>User Submitted</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      background: #eef2f3;
    }

    .container {
      width: 350px;
      margin: 80px auto;
      background: white;
      padding: 20px;
      border-radius: 8px;
      box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
    }
  </style>
</head>

<body>

  <div class="container">
    <h2>User Details</h2>
    <p><strong>Name:</strong> <span id="name">
        <%=username%>
      </span></p>
    <p><strong>Email:</strong> <span id="email">
        <%=email%>
      </span></p>
    <p><strong>Age:</strong> <span id="age">
        <%=age%>
      </span></p>
  </div>

</body>

</html>